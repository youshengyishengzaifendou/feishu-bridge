{
  "name": "feishu-bridge",
  "version": "2.0.0",
  "private": true,
  "description": "飞书运营助理：收到飞书消息 → 按需读飞书表格 → 建提醒/答数据/记实体 → 回飞书。数据落在本地 SQLite。",
  "main": "core/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node core/main.js",
    "setup": "node tools/setup.js",
    "dry": "node --env-file=.env.dry core/main.js",
    "test": "node --env-file=.env.test --test \"test/*.test.js\"",
    "migrate": "node tools/migrate-to-sqlite.js",
    "cli": "node tools/entity-cli.js",
    "tasks": "node tools/entity-cli.js tasks",
    "due": "node tools/entity-cli.js due",
    "catalog": "node tools/entity-cli.js catalog",
    "stats": "node tools/entity-cli.js stats"
  },
  "engines": {
    "node": ">=22.5"
  }
}
